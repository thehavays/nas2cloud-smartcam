# Nas2Cloud SmartCam Environment Configuration (Optional)
# Copy this file to .env to override default parameters: cp .env.example .env

# Timezone (e.g. Europe/Istanbul, America/New_York, Europe/London, Asia/Tokyo)
# By default, the container inherits your host's local timezone via /etc/localtime.
# Uncomment and set TZ if you wish to override:
# TZ=Europe/Istanbul

# Sync & Retention Configuration
# SYNC_INTERVAL=900
# LOCAL_RETENTION_DAYS=7
# REMOTE_RETENTION_DAYS=30
# REMOTE_PATH=Nas2CloudBackup

# Motion Detection Configuration
# MOTION_DETECTION=true
# MOTION_SENSITIVITY=0.04
# MOTION_CLIP_BUFFER=15
# MOTION_CHECK_INTERVAL=600

# Google Cloud OAuth Credentials (Optional - can also be configured via Web UI at http://127.0.0.1:8080)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
